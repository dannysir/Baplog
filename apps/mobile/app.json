{
  "expo": {
    "name": "Baplog",
    "slug": "baplog",
    "scheme": "baplog",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.baplog.app"
    },
    "android": {
      "package": "com.baplog.app"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "$EXPO_PUBLIC_API_URL"
    }
  }
}
