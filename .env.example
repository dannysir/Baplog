# ────────────────────────────────────────────────
# Database (Supabase Postgres or local Docker Postgres)
# ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baplog?schema=public"

# ────────────────────────────────────────────────
# Supabase (server-only secrets must NOT leak to client)
# ────────────────────────────────────────────────
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ────────────────────────────────────────────────
# Google Places (server-only — backend proxies all calls)
# ────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=""

# ────────────────────────────────────────────────
# OAuth (server-only client secrets)
# ────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
KAKAO_OAUTH_CLIENT_ID=""
KAKAO_OAUTH_CLIENT_SECRET=""
NAVER_OAUTH_CLIENT_ID=""
NAVER_OAUTH_CLIENT_SECRET=""

# ────────────────────────────────────────────────
# API runtime
# ────────────────────────────────────────────────
NODE_ENV="development"
PORT="3000"
JWT_SECRET=""

# ────────────────────────────────────────────────
# Mobile (Expo) — only EXPO_PUBLIC_* is exposed to client
# ────────────────────────────────────────────────
EXPO_PUBLIC_API_URL="http://localhost:3000"
