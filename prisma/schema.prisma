// 맛집 지도 서비스 — Prisma 스키마 v2 (검토용)
// v2 변경: 핵심을 기록+사진+SNS로 이동. taste_profile / aspects / category 제거.
// 신규: Photo, Follow, visibility, VISIT.verified.
// PRIOR_WEIGHT / 점수 매핑(5/2.5/1) 등 계산 상수는 DB가 아니라 packages/core 코드에 둔다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// 공개 범위 / 상태 enum
// ─────────────────────────────────────────────
enum Visibility {
  PUBLIC // 친구(accepted 팔로워)에게 공개
  PRIVATE // 본인만
}

enum FollowStatus {
  PENDING // 승인 대기
  ACCEPTED // 수락됨
}

enum PhotoStatus {
  ACTIVE
  PENDING // 신고되어 검토 대기
  REMOVED // 모더레이션으로 내려감
}

enum VisitMethod {
  TAP // 탭/길찾기로 생성된 느슨한 방문 — 평가 자격 없음
  VERIFIED // GPS 근접 등으로 검증된 방문 — 평가 자격 있음
}

// ─────────────────────────────────────────────
// 사용자 (소셜 로그인 전용 — 자체 로그인 없음)
// taste_profile 제거(v2): 카테고리 삭제로 채울 어휘 없음. 협업 필터링은 Rating 행렬로 작동.
// ─────────────────────────────────────────────
model User {
  id         String   @id @default(uuid())
  provider   String // "google" | "kakao" | "naver"
  providerId String // 각 제공자가 발급하는 고유 사용자 ID
  nickname   String
  createdAt  DateTime @default(now())

  visits  Visit[]
  ratings Rating[]
  photos  Photo[]

  // 팔로우 관계 (양방향)
  following Follow[] @relation("follower") // 내가 거는 팔로우
  followers Follow[] @relation("following") // 나를 향한 팔로우

  @@unique([provider, providerId]) // 같은 소셜 계정 중복 가입 방지
  @@map("users")
}

// ─────────────────────────────────────────────
// 가게 (place_id만 저장 — Google 콘텐츠 저장 금지 정책)
// 카테고리 필드 없음(v2 제거).
// ─────────────────────────────────────────────
model Place {
  id            String   @id @default(uuid())
  googlePlaceId String   @unique // Google place_id. 캐싱 제한 면제 — 유일하게 영구 저장 허용.
  createdAt     DateTime @default(now())

  visits  Visit[]
  ratings Rating[]
  photos  Photo[]
  score   PlaceScore?

  @@map("places")
}

// ─────────────────────────────────────────────
// 방문 기록
// verified: 평가 자격 게이트. TAP은 기록만, VERIFIED만 Rating 작성 자격(packages/core가 강제).
// ─────────────────────────────────────────────
model Visit {
  id         String      @id @default(uuid())
  userId     String
  placeId    String
  visitedAt  DateTime    @default(now())
  method     VisitMethod @default(TAP) // [미정] 검증 수단 확정 전까지 기본 TAP
  visibility Visibility  @default(PUBLIC)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  place  Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)
  photos Photo[]

  @@index([userId, visitedAt]) // 개인 지도 / 피드 조회
  @@index([placeId])
  @@map("visits")
}

// ─────────────────────────────────────────────
// 평가 (추천 / 보통 / 비추천) — 단일 verdict, aspects 제거(단순화)
// 익명 집계: verdict 주인은 PLACE_SCORE 집계에만 사용, 피드/타인 화면 노출 금지.
// ─────────────────────────────────────────────
model Rating {
  id        String   @id @default(uuid())
  userId    String
  placeId   String
  verdict   Int // 1 = 추천, 0 = 보통, -1 = 비추천
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId]) // 한 사용자는 한 가게에 평가 1개만 (수정 가능)
  @@map("ratings")
}

// ─────────────────────────────────────────────
// 사진 (신규) — 핵심 기록 단위
// 바이너리는 오브젝트 스토리지, DB엔 키·메타만. 조회 시 서명 URL 발급.
// ─────────────────────────────────────────────
model Photo {
  id         String      @id @default(uuid())
  userId     String
  placeId    String
  visitId    String? // 어느 방문에 귀속(선택)
  storageKey String // 스토리지 객체 키 (URL 직접 저장 안 함)
  width      Int
  height     Int
  visibility Visibility  @default(PUBLIC)
  status     PhotoStatus @default(ACTIVE)
  createdAt  DateTime    @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  visit Visit? @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([placeId, status])
  @@index([userId, createdAt])
  @@map("photos")
}

// ─────────────────────────────────────────────
// 팔로우 (신규) — 승인제, 공개 범위 "친구만"의 기반
// ─────────────────────────────────────────────
model Follow {
  id          String       @id @default(uuid())
  followerId  String // 팔로우 거는 쪽
  followingId String // 팔로우 받는 쪽
  status      FollowStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId]) // 중복 팔로우 방지 (follower != following은 앱 레벨 검증)
  @@index([followingId, status]) // "나를 팔로우한 accepted 목록" 조회
  @@map("follows")
}

// ─────────────────────────────────────────────
// 가게별 집계 점수 (캐시 테이블)
// Rating 추가/수정/삭제 시 카운터 + bayesian_score 동기 갱신 (트랜잭션/atomic).
// ─────────────────────────────────────────────
model PlaceScore {
  placeId       String @id
  upCount       Int    @default(0)
  neutralCount  Int    @default(0)
  downCount     Int    @default(0)
  bayesianScore Float  @default(2.5) // 평가 없으면 사전값 2.5

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@map("place_scores")
}
